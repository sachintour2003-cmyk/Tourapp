<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffc400">
<title>Sachin Tour & Travel | Best Cab Service – Local, Outstation & Airport</title>
<meta name="description" content="Sachin Tour & Travel – Reliable cab service for local rides, outstation trips, and airport transfers. Clean cars, trained drivers, fair prices. Call 8809471421.">
<meta name="keywords" content="cab service, taxi, outstation cab, airport transfer, Sachin Tour Travel">
<meta property="og:title" content="Sachin Tour & Travel | Cab Service">
<meta property="og:description" content="Book your cab in less than a minute. Local, outstation & airport rides.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚖</text></svg>">
<style>
:root{
  --y:#ffc400;--y2:#ffb000;--ink:#14213d;--mut:#51607a;--bg:#fffdf5;
  --card:#fff;--line:#f3e7b8;--blue:#1d4ed8;--g:#16a34a;
  --shadow:0 8px 24px rgba(20,33,61,.08);
  color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  -webkit-tap-highlight-color:transparent;
}
a{color:inherit;text-decoration:none}
img{max-width:100%;display:block}
button{font-family:inherit}
.wrap{max-width:1000px;margin:0 auto;padding:0 18px}

/* Header */
header{position:sticky;top:0;z-index:50;background:#fff;box-shadow:0 2px 12px rgba(20,33,61,.08)}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:62px}
.logo{font-weight:800;font-size:19px;display:flex;align-items:center;gap:8px}
.logo span{background:var(--y);padding:2px 8px;border-radius:8px}
.call{background:var(--ink);color:#fff;padding:9px 16px;border-radius:999px;font-weight:700;font-size:14px;transition:transform .15s}
.call:hover{transform:scale(1.05)}

/* Hero */
.hero{background:linear-gradient(135deg,#ffd43b 0%,#ffb000 55%,#ff8a00 100%);padding:54px 0 64px;text-align:center;position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 20% 20%,rgba(255,255,255,.35),transparent 60%);pointer-events:none}
.hero .tag{display:inline-block;background:#fff;border-radius:999px;padding:5px 14px;font-size:13px;font-weight:700;margin-bottom:14px;position:relative}
.hero h1{font-size:clamp(30px,7vw,52px);margin:0 0 12px;line-height:1.12;color:var(--ink);position:relative}
.hero p{max-width:540px;margin:0 auto 24px;font-size:17px;color:#2b3a55;position:relative}
.btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;position:relative}
.btn{
  display:inline-block;border:0;border-radius:12px;padding:14px 26px;
  font-weight:700;font-size:16px;cursor:pointer;
  background:var(--ink);color:#fff;box-shadow:0 6px 16px rgba(20,33,61,.22);
  transition:transform .15s,box-shadow .15s;
}
.btn:hover{transform:translateY(-2px);box-shadow:0 10px 20px rgba(20,33,61,.28)}
.btn:active{transform:translateY(0)}
.btn.w{background:#fff;color:var(--ink)}
.btn.g{background:var(--g);color:#fff}
.btn:focus-visible{outline:3px solid var(--blue);outline-offset:2px}

/* Sections */
h2{font-size:clamp(22px,5vw,28px);margin:44px 0 6px;text-align:center}
.sub{text-align:center;color:var(--mut);margin:0 0 22px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px}
.card{
  background:var(--card);border:2px solid var(--line);border-radius:18px;
  padding:20px;text-align:center;transition:transform .2s,border-color .2s,box-shadow .2s;
}
.card:hover{transform:translateY(-3px);border-color:var(--y2);box-shadow:var(--shadow)}
.ic{width:56px;height:56px;margin:0 auto 10px;border-radius:16px;background:var(--y);display:flex;align-items:center;justify-content:center;font-size:28px}
.card h3{margin:0 0 4px;font-size:18px}
.card p{margin:0;color:var(--mut);font-size:14px}

/* Steps */
.steps{counter-reset:s;margin-top:20px}
.steps .card{position:relative;padding-top:34px}
.steps .card:before{
  counter-increment:s;content:counter(s);
  position:absolute;top:-16px;left:50%;transform:translateX(-50%);
  width:34px;height:34px;border-radius:50%;background:var(--blue);color:#fff;
  font-weight:800;display:flex;align-items:center;justify-content:center;
  box-shadow:0 4px 10px rgba(29,78,216,.35);
}

/* Booking Form */
.book-section{margin-top:44px}
.form{
  background:#fff;border:2px solid var(--line);border-radius:22px;
  padding:26px;max-width:640px;margin:0 auto;box-shadow:var(--shadow);
}
.form .row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form label{display:block;font-size:13px;font-weight:700;margin-bottom:6px;color:var(--ink)}
.form input,.form select,.form textarea{
  width:100%;padding:12px 14px;border:2px solid #e6e0c8;border-radius:12px;
  font-size:15px;font-family:inherit;background:#fffdf5;
  transition:border-color .15s,box-shadow .15s;
}
.form input:focus,.form select:focus,.form textarea:focus{
  outline:0;border-color:var(--y2);box-shadow:0 0 0 4px rgba(255,196,0,.2);
}
.form .full{grid-column:1/-1}
.form textarea{resize:vertical;min-height:80px}
.form .btn{width:100%;margin-top:6px}
@media(max-width:520px){.form .row{grid-template-columns:1fr}}

/* CTA */
.cta{margin:46px 0 0;background:linear-gradient(135deg,#1d4ed8,#2563eb);color:#fff;border-radius:22px;padding:34px 20px;text-align:center}
.cta h2{margin:0 0 8px;color:#fff}
.cta p{margin:0 0 18px;opacity:.92}
.cta .btn{background:var(--y);color:var(--ink)}

/* FAQ */
.faq{max-width:720px;margin:0 auto;display:grid;gap:12px}
.faq details{
  background:#fff;border:2px solid var(--line);border-radius:14px;
  padding:14px 18px;cursor:pointer;transition:border-color .15s;
}
.faq details[open]{border-color:var(--y2)}
.faq summary{font-weight:700;list-style:none;display:flex;justify-content:space-between;align-items:center}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font-size:22px;color:var(--y2);font-weight:800}
.faq details[open] summary::after{content:"–"}
.faq p{margin:10px 0 0;color:var(--mut);font-size:15px}

/* Footer */
footer{margin-top:44px;background:var(--ink);color:#dfe6f5;padding:26px 0 30px;text-align:center;font-size:14px}
footer b{color:var(--y)}
footer a:hover{color:var(--y)}

/* Floating buttons */
.float{position:fixed;right:14px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:60;display:flex;flex-direction:column;gap:10px}
.float a{
  width:54px;height:54px;border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:24px;box-shadow:0 6px 16px rgba(0,0,0,.25);color:#fff;
  transition:transform .2s;
}
.float a:hover{transform:scale(1.1)}

/* Toast */
.toast{
  position:fixed;left:50%;bottom:24px;transform:translate(-50%,200%);
  background:var(--ink);color:#fff;padding:12px 22px;border-radius:12px;
  font-weight:600;font-size:14px;z-index:100;transition:transform .3s ease;
  box-shadow:0 10px 25px rgba(0,0,0,.3);
}
.toast.show{transform:translate(-50%,0)}
</style>
</head>
<body>

<header>
  <div class="wrap">
    <div class="logo"><span>🚖</span>Sachin Tour &amp; Travel</div>
    <a class="call" href="tel:8809471421" aria-label="Call Now">📞 Call Now</a>
  </div>
</header>

<section class="hero">
  <div class="wrap">
    <div class="tag">⭐ Reliable Cab Service</div>
    <h1>Book Your Cab.<br>Travel With Comfort.</h1>
    <p>Clean cars, professional drivers and fair prices. Local trips, outstation journeys and airport transfers, all in one place.</p>
    <div class="btns">
      <a class="btn" href="#book">🚖 Book a Cab</a>
      <a class="btn w" href="tel:8809471421">📞 Call 8809471421</a>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>Our Cab Services</h2>
    <p class="sub">Whatever the distance, we get you there on time.</p>
    <div class="grid">
      <div class="card"><div class="ic">🏙️</div><h3>Local Rides</h3><p>Quick and affordable cabs within the city.</p></div>
      <div class="card"><div class="ic">🛣️</div><h3>Outstation Trips</h3><p>One-way and round-trip cabs to any city.</p></div>
      <div class="card"><div class="ic">✈️</div><h3>Airport Transfers</h3><p>On-time pickup and drop for every flight.</p></div>
      <div class="card"><div class="ic">👨‍👩‍👧</div><h3>Family &amp; Group Travel</h3><p>Spacious cars for weddings, tours and events.</p></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>Why Choose Us</h2>
    <p class="sub">Simple, safe and honest travel.</p>
    <div class="grid">
      <div class="card"><div class="ic">✅</div><h3>Clean &amp; Comfortable</h3><p>Well-maintained cars, AC available.</p></div>
      <div class="card"><div class="ic">👮</div><h3>Trained Drivers</h3><p>Polite, experienced and punctual.</p></div>
      <div class="card"><div class="ic">💰</div><h3>Fair Pricing</h3><p>Clear rates with no hidden charges.</p></div>
      <div class="card"><div class="ic">🕒</div><h3>Available 24/7</h3><p>Early morning or late night, we are ready.</p></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>How Booking Works</h2>
    <p class="sub">Three easy steps.</p>
    <div class="grid steps">
      <div class="card"><h3>Fill the Form</h3><p>Share your name, number and pickup location.</p></div>
      <div class="card"><h3>We Confirm</h3><p>We call you with the car and fare details.</p></div>
      <div class="card"><h3>Enjoy the Ride</h3><p>Your driver arrives on time at your door.</p></div>
    </div>
  </div>
</section>

<!-- Booking Form -->
<section class="book-section" id="book">
  <div class="wrap">
    <h2>Book Your Cab</h2>
    <p class="sub">Form bharo — hum WhatsApp par turant confirm karenge.</p>
    <form class="form" id="bookForm" novalidate>
      <div class="row">
        <div>
          <label for="name">Your Name *</label>
          <input type="text" id="name" name="name" placeholder="Aapka naam" required>
        </div>
        <div>
          <label for="phone">Mobile Number *</label>
          <input type="tel" id="phone" name="phone" placeholder="10-digit number" pattern="[0-9]{10}" required>
        </div>
        <div>
          <label for="pickup">Pickup Location *</label>
          <input type="text" id="pickup" name="pickup" placeholder="e.g. Patna Railway Station" required>
        </div>
        <div>
          <label for="drop">Drop Location *</label>
          <input type="text" id="drop" name="drop" placeholder="e.g. Gaya Airport" required>
        </div>
        <div>
          <label for="date">Travel Date *</label>
          <input type="date" id="date" name="date" required>
        </div>
        <div>
          <label for="trip">Trip Type</label>
          <select id="trip" name="trip">
            <option>One Way</option>
            <option>Round Trip</option>
            <option>Local (Hourly)</option>
            <option>Airport Transfer</option>
          </select>
        </div>
        <div class="full">
          <label for="notes">Additional Notes (optional)</label>
          <textarea id="notes" name="notes" placeholder="Passengers, luggage, ya koi special request..."></textarea>
        </div>
      </div>
      <button type="submit" class="btn g">💬 Book on WhatsApp</button>
    </form>
  </div>
</section>

<section>
  <div class="wrap">
    <h2>FAQs</h2>
    <p class="sub">Common sawaal — jawab yahin mil jayenge.</p>
    <div class="faq">
      <details>
        <summary>Kya booking ke liye advance dena padta hai?</summary>
        <p>Nahi, koi advance zaroori nahi. Aap booking confirm karne ke baad ride ke time payment kar sakte hain.</p>
      </details>
      <details>
        <summary>Outstation ke liye per km rate kya hai?</summary>
        <p>Rate car type aur distance par depend karta hai. Best price ke liye humein call karein — hum aapko turant quote denge.</p>
      </details>
      <details>
        <summary>Kya AC aur non-AC dono options hain?</summary>
        <p>Ji haan, hum AC aur non-AC dono tarah ki gaadiyan provide karte hain. Aap apni pasand batayein.</p>
      </details>
      <details>
        <summary>Kya aap airport pickup ke liye flight tracking karte hain?</summary>
        <p>Haan, hum flight timing track karte hain, so aapki flight late bhi ho jaye to driver wait karega.</p>
      </details>
    </div>
  </div>
</section>

<div class="cta-wrap wrap" style="margin-top:46px">
  <div class="cta">
    <h2>Ready to Ride?</h2>
    <p>Book in less than a minute, or call us directly.</p>
    <div class="btns"><a class="btn" href="#book">🚖 Book a Cab</a></div>
  </div>
</div>

<footer>
  <div class="wrap">
    <div><b>Sachin Tour &amp; Travel</b></div>
    <div style="margin-top:6px">
      📞 <a href="tel:8809471421">8809471421</a> &nbsp;|&nbsp;
      📞 <a href="tel:8076910835">8076910835</a>
    </div>
    <div style="margin-top:6px;opacity:.7">© 2026 Sachin Tour &amp; Travel. All rights reserved.</div>
  </div>
</footer>

<div class="float">
  <a href="https://wa.me/918809471421" target="_blank" rel="noopener" style="background:#25d366" aria-label="Chat on WhatsApp" title="WhatsApp">💬</a>
  <a href="tel:8809471421" style="background:var(--blue)" aria-label="Call us" title="Call">📞</a>
</div>

<div class="toast" id="toast">✅ WhatsApp par bhej rahe hain...</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "TaxiService",
  "name": "Sachin Tour & Travel",
  "telephone": "+918809471421",
  "areaServed": "India",
  "priceRange": "₹₹",
  "openingHours": "Mo-Su 00:00-23:59"
}
</script>

<script>
(function () {
  var WHATSAPP = "918809471421";
  var form = document.getElementById("bookForm");
  var toast = document.getElementById("toast");

  // Set min date to today
  var today = new Date().toISOString().split("T")[0];
  document.getElementById("date").min = today;

  form.addEventListener("submit", function (e) {
    e.preventDefault();

    var name = form.name.value.trim();
    var phone = form.phone.value.trim();
    var pickup = form.pickup.value.trim();
    var drop = form.drop.value.trim();
    var date = form.date.value;
    var trip = form.trip.value;
    var notes = form.notes.value.trim();

    if (!name || !phone || !pickup || !drop || !date) {
      showToast("⚠️ Please fill all required fields");
      return;
    }
    if (!/^[0-9]{10}$/.test(phone)) {
      showToast("⚠️ Enter a valid 10-digit mobile number");
      return;
    }

    var msg =
      "*New Cab Booking Request*\n" +
      "👤 Name: " + name + "\n" +
      "📱 Phone: " + phone + "\n" +
      "📍 Pickup: " + pickup + "\n" +
      "🎯 Drop: " + drop + "\n" +
      "📅 Date: " + date + "\n" +
      "🚕 Trip: " + trip +
      (notes ? "\n📝 Notes: " + notes : "");

    var url = "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(msg);
    showToast("✅ WhatsApp khol rahe hain...");
    setTimeout(function () {
      window.open(url, "_blank", "noopener");
    }, 300);
  });

  function showToast(text) {
    toast.textContent = text;
    toast.classList.add("show");
    clearTimeout(toast._t);
    toast._t = setTimeout(function () {
      toast.classList.remove("show");
    }, 2500);
  }
})();
</script>

</body>
